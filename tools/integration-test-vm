phase_switch() {
  local phase="server-switch"
  if ((SKIP_SWITCH)); then
    phase_mark SKIP "${phase}" "requested or single config"
    return 0
  fi
  if [[ -z "${SECOND_PROFILE}" || "${SECOND_PROFILE}" == "${FIRST_PROFILE}" ]]; then
    phase_mark FAIL "${phase}" "switch testing enabled but second managed profile is missing"
    on_failure_guidance
    return 1
  fi

  local pidfile="${ARTIFACT_DIR}/switch-probe.pids"
  local run_marker="${ARTIFACT_DIR}/switch-probe.run"
  local probe_log="${ARTIFACT_DIR}/switch-probes.log"
  : >"${pidfile}"
  : >"${probe_log}"
  touch "${run_marker}"

  (
    local observed class
    # Continue for the whole switch (and optional switch-back), not a fixed wall clock.
    while [[ -f "${run_marker}" ]]; do
      observed="$(lookup_public_ip 4 || echo fail)"
      class="$(it_classify_switch_observation "${observed}" "${BASELINE_IPV4}" "${FIRST_VPN_IPV4}" "${SECOND_VPN_IPV4}")"
      printf '%s observed=%s class=%s\n' "$(date -Is)" "${observed}" "${class}" >>"${probe_log}"
      if [[ "${class}" == "baseline_leak" ]]; then
        printf 'LEAK\n' >>"${probe_log}"
      fi
      sleep 1
    done
    # Short post-stop grace samples while switch-back settles.
    local i
    for i in 1 2 3; do
      observed="$(lookup_public_ip 4 || echo fail)"
      class="$(it_classify_switch_observation "${observed}" "${BASELINE_IPV4}" "${FIRST_VPN_IPV4}" "${SECOND_VPN_IPV4}")"
      printf '%s observed=%s class=%s post\n' "$(date -Is)" "${observed}" "${class}" >>"${probe_log}"
      if [[ "${class}" == "baseline_leak" ]]; then
        printf 'LEAK\n' >>"${probe_log}"
      fi
      sleep 1
    done
  ) &
  echo $! >>"${pidfile}"
  trap 'rm -f "'"${run_marker}"'"; it_cleanup_pidfile "'"${pidfile}"'"' EXIT

  if ! sudo_capture "switch-activate.log" airvpn-switch --name "${SECOND_PROFILE}"; then
    it_stop_probe_loop "${run_marker}" "${pidfile}"
    trap - EXIT
    phase_mark FAIL "${phase}" "switch to second profile failed"
    on_failure_guidance
    return 1
  fi

  SECOND_VPN_IPV4="$(lookup_public_ip 4 || true)"
  append_artifact "switch-probes.log" "second_vpn_ipv4=${SECOND_VPN_IPV4:-unavailable}"$'\n'

  # Optional switch back once while probes are still running.
  sudo airvpn-switch --name "${FIRST_PROFILE}" >/dev/null 2>&1 || true
  sleep 2
  it_stop_probe_loop "${run_marker}" "${pidfile}"
  trap - EXIT

  if grep -q '^LEAK$' "${probe_log}" 2>/dev/null; then
    phase_mark FAIL "${phase}" "baseline public IP observed during switch"
    on_failure_guidance
    return 1
  fi
  local multi
  multi="$(count_active_managed)"
  if [[ "${multi}" -gt 1 ]]; then
    phase_mark FAIL "${phase}" "multiple managed VPNs active (${multi})"
    on_failure_guidance
    return 1
  fi
  phase_mark PASS "${phase}"
}

phase_forced_disconnect() {
  local phase="forced-disconnect"
  if ((SKIP_FORCED_DISCONNECT)); then
    phase_mark SKIP "${phase}" "requested"
    return 0
  fi

  # Ensure a VPN is up
  sudo airvpn-switch --name "${FIRST_PROFILE}" >/dev/null 2>&1 || true
  if ! sudo_capture "forced-disconnect.log" airvpn-switch --disconnect; then
    phase_mark FAIL "${phase}" "disconnect failed"
    on_failure_guidance
    return 1
  fi

  local p4=0 p6=0
  probe_public_http 4 && p4=1
  probe_public_http 6 && p6=1
  append_artifact "forced-disconnect.log" "after_disconnect http4=${p4} http6=${p6}"$'\n'
  if ((p4 == 1 || p6 == 1)); then
    phase_mark FAIL "${phase}" "public traffic after disconnect"
    on_failure_guidance
    return 1
  fi

  if ! sudo airvpn-switch --name "${FIRST_PROFILE}" >>"${ARTIFACT_DIR}/forced-disconnect.log" 2>&1; then
    phase_mark FAIL "${phase}" "reactivation failed"
    on_failure_guidance
    return 1
  fi
  it_redact_text "$(cat "${ARTIFACT_DIR}/forced-disconnect.log")" >"${ARTIFACT_DIR}/forced-disconnect.redacted"
  mv "${ARTIFACT_DIR}/forced-disconnect.redacted" "${ARTIFACT_DIR}/forced-disconnect.log"
  phase_mark PASS "${phase}"
}

phase_suspend() {
  local phase="suspend-resume"
  if ((RUN_SUSPEND == 0)); then
    phase_mark SKIP "${phase}" "disabled by default; pass --enable-suspend"
    return 0
  fi
  if ((NON_INTERACTIVE)); then
    phase_mark SKIP "${phase}" "requires interactive confirmation"
    return 0
  fi
  cat <<'EOF'
Pause or suspend the VM now.
Resume it, wait until the guest is usable, then press Enter.
EOF
  read -r -p "Press Enter after resume: " _
  local active
  active="$(count_active_managed)"
  if [[ "${active}" -gt 1 ]]; then
    phase_mark FAIL "${phase}" "more than one managed VPN active"
    return 1
  fi
  local observed
  observed="$(lookup_public_ip 4 || echo fail)"
  local class
  class="$(it_classify_switch_observation "${observed}" "${BASELINE_IPV4}" "${FIRST_VPN_IPV4}" "${SECOND_VPN_IPV4}")"
  write_artifact "resume-check.log" "active_managed=${active}"$'\n'"observed=${observed}"$'\n'"class=${class}"$'\n'
  if [[ "${class}" == "baseline_leak" ]]; then
    phase_mark FAIL "${phase}" "baseline IP after resume"
    on_failure_guidance
    return 1
  fi
  phase_mark PASS "${phase}"
}

phase_idempotency() {
  local phase="idempotency"
  if ! run_ansible_capture "idempotency.log" "${ROOT}/playbooks/install.yml" \
    -e "airvpn_config_source=${CONFIG_SOURCE}"; then
    phase_mark FAIL "${phase}" "second install failed"
    on_failure_guidance
    return 1
  fi
  local changed
  changed="$(grep -E 'changed=[0-9]+' "${ARTIFACT_DIR}/idempotency.log" | tail -n1 || true)"
  # Document: some tasks may still report changed (e.g. firewall reload). Fail only on play failure.
  if grep -q 'failed=[1-9]' "${ARTIFACT_DIR}/idempotency.log"; then
    phase_mark FAIL "${phase}" "failed tasks present"
    return 1
  fi
  local profiles
  profiles="$(managed_profile_names | wc -l)"
  append_artifact "idempotency.log" "managed_profile_count=${profiles}"$'\n'"recap_line=${changed}"$'\n'
  phase_mark PASS "${phase}" "profiles=${profiles} ${changed}"
}

phase_uninstall() {
  local phase="uninstall"
  if ((SKIP_UNINSTALL)); then
    phase_mark SKIP "${phase}" "requested; kill switch may remain active"
    KILL_SWITCH_MAY_BE_ACTIVE=1
    return 0
  fi
  reload_runtime_config
  if ! run_ansible_capture "uninstall.log" "${ROOT}/playbooks/uninstall.yml" \
    -e "airvpn_uninstall_confirmed=true"; then
    phase_mark FAIL "${phase}" "uninstall playbook failed"
    on_failure_guidance
    return 1
  fi

  local fails=0
  # Policies should be gone. Distinguish present vs absent vs sudo/tool errors.
  local fw_out fw_rc class
  set +e
  fw_out="$(sudo_firewall_cmd --permanent --info-policy "${AIRVPN_POLICY_TO_VPN}" 2>&1)"
  fw_rc=$?
  set -e
  class="$(it_classify_firewall_info_absence "${fw_rc}" "${fw_out}")"
  case "${class}" in
    present | error) fails=$((fails + 1)) ;;
  esac
  set +e
  fw_out="$(sudo_firewall_cmd --permanent --info-policy "${AIRVPN_POLICY_TO_UNDERLAY}" 2>&1)"
  fw_rc=$?
  set -e
  class="$(it_classify_firewall_info_absence "${fw_rc}" "${fw_out}")"
  case "${class}" in
    present | error) fails=$((fails + 1)) ;;
  esac
  command -v airvpn-check >/dev/null 2>&1 && fails=$((fails + 1))
  systemctl is-active --quiet NetworkManager || fails=$((fails + 1))
  systemctl is-active --quiet firewalld || fails=$((fails + 1))

  {
    echo "=== post uninstall nmcli ==="
    nmcli_connection_terse || true
    echo "=== post uninstall zones ==="
    sudo_firewall_cmd --get-zones || true
    echo "=== ip -4 route ==="
    ip -4 route || true
  } >"${ARTIFACT_DIR}/post-uninstall-network.raw" 2>&1 || true
  it_redact_text "$(cat "${ARTIFACT_DIR}/post-uninstall-network.raw")" >"${ARTIFACT_DIR}/post-uninstall-network.txt"
  rm -f "${ARTIFACT_DIR}/post-uninstall-network.raw"

  # Connectivity should return after uninstall (best-effort).
  sleep 2
  if ! probe_public_http 4; then
    phase_mark WARN "${phase}-connectivity" "IPv4 not restored yet (check DNS/DHCP)"
  fi

  if ((fails == 0)); then
    phase_mark PASS "${phase}"
    KILL_SWITCH_MAY_BE_ACTIVE=0
    STATE_UNCERTAIN=0
  else
    phase_mark FAIL "${phase}" "${fails} assertion failure(s)"
    on_failure_guidance
    return 1
  fi
}

write_summary() {
  {
    echo "=== fedora-airvpn-killswitch live VM integration summary ==="
    date -Is
    it_summary_lines
    echo
    echo "artifacts=${ARTIFACT_DIR}"
    echo "kill_switch_may_be_active=${KILL_SWITCH_MAY_BE_ACTIVE}"
    echo "state_uncertain=${STATE_UNCERTAIN}"
    if ((STATE_UNCERTAIN)); then
      echo "ACTION: Prefer restoring the VM snapshot. Do not flush firewalls."
    fi
  } | tee "${ARTIFACT_DIR}/summary.txt"
}

main() {
  it_report_reset
  parse_args "$@"

  # Consent gate before any state-changing work (help already exited).
  if ((CONSENT != 1)); then
    usage >&2
    die "Refusing to proceed without --i-understand-this-modifies-networking"
  fi

  preflight

  phase_static || true
  if ((IT_FAIL_N > 0)); then
    write_summary
    exit 1
  fi

  phase_ansible_syntax || true
  if ((IT_FAIL_N > 0)); then
    write_summary
    exit 1
  fi

  phase_baseline

  if ! phase_install; then
    write_summary
    exit 1
  fi

  if ! phase_offline; then
    write_summary
    exit 1
  fi

  if ! phase_first_vpn; then
    write_summary
    exit 1
  fi

  phase_diagnostics

  if ! phase_switch; then
    write_summary
    exit 1
  fi

  if ! phase_forced_disconnect; then
    write_summary
    exit 1
  fi

  if ! phase_suspend; then
    write_summary
    exit 1
  fi

  if ! phase_idempotency; then
    write_summary
    exit 1
  fi

  if ! phase_uninstall; then
    write_summary
    exit 1
  fi

  write_summary
  it_exit_code_from_summary
}

# Only run main when executed, not when sourced by unit tests.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
