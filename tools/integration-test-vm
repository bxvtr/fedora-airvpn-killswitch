phase_install() {
  local phase="install"
  KILL_SWITCH_MAY_BE_ACTIVE=1
  if ! run_ansible_capture "install.log" "${ROOT}/playbooks/install.yml" \
    -e "airvpn_config_source=${CONFIG_SOURCE}"; then
    phase_mark FAIL "${phase}" "playbook failed"
    on_failure_guidance
    return 1
  fi

  reload_runtime_config

  local fails=0
  systemctl is-active --quiet firewalld || fails=$((fails + 1))
  systemctl is-active --quiet NetworkManager || fails=$((fails + 1))
  sudo_firewall_cmd --permanent --info-zone="${AIRVPN_ZONE}" >/dev/null 2>&1 || fails=$((fails + 1))
  sudo_firewall_cmd --permanent --info-zone="${AIRVPN_UNDERLAY_ZONE}" >/dev/null 2>&1 || fails=$((fails + 1))
  sudo_firewall_cmd --permanent --info-policy "${AIRVPN_POLICY_TO_VPN}" >/dev/null 2>&1 || fails=$((fails + 1))
  sudo_firewall_cmd --permanent --info-policy "${AIRVPN_POLICY_TO_UNDERLAY}" >/dev/null 2>&1 || fails=$((fails + 1))

  {
    echo "=== zones ==="
    sudo_firewall_cmd --permanent --info-zone="${AIRVPN_ZONE}" || true
    sudo_firewall_cmd --permanent --info-zone="${AIRVPN_UNDERLAY_ZONE}" || true
    echo "=== policies ==="
    sudo_firewall_cmd --permanent --info-policy "${AIRVPN_POLICY_TO_VPN}" || true
    sudo_firewall_cmd --permanent --info-policy "${AIRVPN_POLICY_TO_UNDERLAY}" || true
  } >"${ARTIFACT_DIR}/installed-firewall.raw" 2>&1 || true
  it_redact_text "$(cat "${ARTIFACT_DIR}/installed-firewall.raw")" >"${ARTIFACT_DIR}/installed-firewall.txt"
  rm -f "${ARTIFACT_DIR}/installed-firewall.raw"

  nmcli_connection_terse >"${ARTIFACT_DIR}/installed-networkmanager.txt" 2>&1 || true

  local active_vpn
  active_vpn="$(count_active_managed)"
  [[ "${active_vpn}" == "0" ]] || fails=$((fails + 1))

  command -v airvpn-check >/dev/null || fails=$((fails + 1))
  command -v airvpn-switch >/dev/null || fails=$((fails + 1))

  if ((fails == 0)); then
    phase_mark PASS "${phase}"
  else
    phase_mark FAIL "${phase}" "${fails} assertion failure(s)"
    on_failure_guidance
    return 1
  fi
}

phase_offline() {
  local phase="offline-fail-closed"
  local out=""
  local ok=1
  if sudo airvpn-check --offline >"${ARTIFACT_DIR}/offline-check.raw" 2>&1; then
    out="$(cat "${ARTIFACT_DIR}/offline-check.raw")"
  else
    out="$(cat "${ARTIFACT_DIR}/offline-check.raw" 2>/dev/null || true)"
    ok=0
  fi
  write_artifact "offline-probes.log" "${out}"

  # Failed public probes are PASS here.
  local p4=0 p6=0 pdns=0
  probe_public_http 4 && p4=1
  probe_public_http 6 && p6=1
  probe_dns example.com && pdns=1
  append_artifact "offline-probes.log" $'\n'"probe_http4=${p4} (0=blocked PASS)"$'\n'"probe_http6=${p6}"$'\n'"probe_dns=${pdns}"$'\n'

  if ((p4 == 1)); then
    ok=0
    append_artifact "offline-probes.log" "FAIL: public IPv4 reachable without VPN"$'\n'
  fi
  if ((p6 == 1)); then
    ok=0
    append_artifact "offline-probes.log" "FAIL: public IPv6 reachable without VPN"$'\n'
  fi
  if ((pdns == 1)); then
    # DNS may still resolve from cache; treat success as WARN unless HTTP also works.
    if ((p4 == 1 || p6 == 1)); then
      ok=0
    else
      phase_mark WARN "${phase}-dns" "getent succeeded while HTTP blocked (possible cache)"
    fi
  fi

  if ((ok)); then
    phase_mark PASS "${phase}" "ordinary public traffic blocked"
  else
    phase_mark FAIL "${phase}"
    on_failure_guidance
    return 1
  fi
}

phase_first_vpn() {
  local phase="first-vpn"
  local names selected first second
  local require_second=0
  local online_ok=1
  ((SKIP_SWITCH == 0)) && require_second=1
  names="$(managed_profile_names)"
  selected="$(it_select_profiles "${names}" "${FIRST_PROFILE}" "${SECOND_PROFILE}" "${require_second}")" || {
    if ((require_second)); then
      phase_mark FAIL "${phase}" "need two distinct managed profiles for switch testing"
    else
      phase_mark FAIL "${phase}" "could not select managed profiles"
    fi
    return 1
  }
  IFS='|' read -r first second <<<"${selected}"
  FIRST_PROFILE="${first}"
  SECOND_PROFILE="${second}"
  write_artifact "first-vpn.log" "selected_first=${first}"$'\n'"selected_second=${second:-none}"$'\n'"prefix=${AIRVPN_CONNECTION_PREFIX}"$'\n'

  if ! sudo_capture "first-vpn-activate.log" airvpn-switch --name "${first}"; then
    phase_mark FAIL "${phase}" "airvpn-switch --name failed"
    on_failure_guidance
    return 1
  fi
  append_artifact "first-vpn.log" "$(cat "${ARTIFACT_DIR}/first-vpn-activate.log")"

  capture_vpn_routing_diagnostics "first-vpn"

  if ! sudo_capture "online-check.log" airvpn-check --online; then
    online_ok=0
    append_artifact "first-vpn.log" "online_check=FAIL"$'\n'
  else
    append_artifact "first-vpn.log" "online_check=PASS"$'\n'
  fi

  # Layered egress probes for classification (mocked in unit tests via PATH overrides).
  local dns_ok=0 https_ok=0
  if probe_dns example.com; then
    dns_ok=1
  fi
  if probe_public_http 4; then
    https_ok=1
  fi

  # Always attempt egress capture for artifacts, even when online-check failed.
  # Do not capture via $(...); it_lookup_public_ipv4 must run in this shell so
  # IT_LAST_PUBLIC_IP_* diagnostics remain available for the artifact.
  local lookup_restore_errexit=0
  [[ $- == *e* ]] && lookup_restore_errexit=1
  set +e
  it_lookup_public_ipv4 >/dev/null
  ((lookup_restore_errexit)) && set -e
  FIRST_VPN_IPV4="${IT_LAST_PUBLIC_IP:-}"

  append_artifact "first-vpn.log" "vpn_ipv4=${FIRST_VPN_IPV4:-unavailable}"$'\n'
  append_artifact "first-vpn.log" "public_ip_probe_status=${IT_LAST_PUBLIC_IP_STATUS:-unknown}"$'\n'
  append_artifact "first-vpn.log" "public_ip_probe_attempts=${IT_LAST_PUBLIC_IP_ATTEMPTS:-0}"$'\n'
  append_artifact "first-vpn.log" "public_ip_probe_failure_class=${IT_LAST_PUBLIC_IP_FAILURE_CLASS:-}"$'\n'
  append_artifact "first-vpn.log" "generic_https_probe=${https_ok}"$'\n'
  append_artifact "first-vpn.log" "dns_probe=${dns_ok}"$'\n'
  if [[ -n "${IT_LAST_PUBLIC_IP_DIAG:-}" ]]; then
    append_artifact "first-vpn.log" "public_ip_probe_diag<<"$'\n'"${IT_LAST_PUBLIC_IP_DIAG}"
  fi

  if ((online_ok == 0)); then
    phase_mark FAIL "${phase}" "airvpn-check --online failed"
    on_failure_guidance
    return 1
  fi

  local rc=0
  local fail_msg=""
  it_public_ip_differs_from_baseline "${FIRST_VPN_IPV4}" "${BASELINE_IPV4}" || rc=$?
  if [[ -n "${FIRST_VPN_IPV4}" && -n "${BASELINE_IPV4}" && "${rc}" -eq 1 ]]; then
    fail_msg="$(it_first_vpn_public_ip_failure_message \
      "${FIRST_VPN_IPV4}" "${BASELINE_IPV4}" "${dns_ok}" "${https_ok}" \
      "${IT_LAST_PUBLIC_IP_FAILURE_CLASS:-}")"
    phase_mark FAIL "${phase}" "${fail_msg}"
    on_failure_guidance
    return 1
  fi
  if [[ -z "${FIRST_VPN_IPV4}" ]]; then
    fail_msg="$(it_first_vpn_public_ip_failure_message \
      "" "${BASELINE_IPV4}" "${dns_ok}" "${https_ok}" \
      "${IT_LAST_PUBLIC_IP_FAILURE_CLASS:-lookup_inconclusive}")"
    phase_mark FAIL "${phase}" "${fail_msg}"
    on_failure_guidance
    return 1
  fi
  phase_mark PASS "${phase}" "ip=${FIRST_VPN_IPV4}"
}

