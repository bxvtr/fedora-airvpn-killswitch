#!/usr/bin/env bash
# Opt-in Fedora VM end-to-end integration test for the AirVPN kill switch.
#
# WARNING: Modifies NetworkManager, firewalld, WireGuard, and routing inside
# the guest. Never run automatically from CI, pre-commit, tools/validate-safe,
# or Cursor agents without explicit human authorization inside a disposable VM.
#
# This script refuses to run as root. It uses sudo only for privileged steps.
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LIB_DIR="${ROOT}/tests/integration/lib"

# shellcheck source=../tests/integration/lib/report.sh
source "${LIB_DIR}/report.sh"
# shellcheck source=../tests/integration/lib/diagnostics.sh
source "${LIB_DIR}/diagnostics.sh"
# shellcheck source=../tests/integration/lib/network-probes.sh
source "${LIB_DIR}/network-probes.sh"
# shellcheck source=../tests/integration/lib/assertions.sh
source "${LIB_DIR}/assertions.sh"
# shellcheck source=../tests/integration/lib/ansible-invoke.sh
source "${LIB_DIR}/ansible-invoke.sh"
# shellcheck source=../roles/airvpn_client/files/lib/airvpn-common.sh
source "${ROOT}/roles/airvpn_client/files/lib/airvpn-common.sh"

CONSENT=0
CONFIG_SOURCE=""
CONFIG_FILE=""
FIRST_PROFILE=""
SECOND_PROFILE=""
OUTPUT_DIR=""
SKIP_CHECK_MODE=0
SKIP_SWITCH=0
SKIP_FORCED_DISCONNECT=0
SKIP_SUSPEND=1
RUN_SUSPEND=0
SKIP_UNINSTALL=0
SNAPSHOT_CONFIRMED=0
ALLOW_NON_VM=0
ALLOW_NON_VM_CONFIRMED=0
KEEP_ARTIFACTS=1
NON_INTERACTIVE=0
ALLOW_DIRTY_TREE=0

ARTIFACT_DIR=""
BASELINE_IPV4=""
BASELINE_IPV6=""
FIRST_VPN_IPV4=""
SECOND_VPN_IPV4=""
ANSIBLE_BIN=""
ANSIBLE_PYTHON_INTERPRETER="/usr/bin/python3"
STATE_UNCERTAIN=0
KILL_SWITCH_MAY_BE_ACTIVE=0

usage() {
  cat <<'EOF'
Usage: tools/integration-test-vm --config-source DIR \
         --i-understand-this-modifies-networking [options]

Opt-in live Fedora VM integration test. Exercises install, fail-closed
offline posture, VPN activation, server switch, forced disconnect,
idempotency, and uninstall using the project's playbooks and runtime
commands.

Required:
  --config-source DIR
      Absolute path outside the Git repository containing AirVPN WireGuard
      .conf files (numeric endpoints). Keep secrets out of the clone.
  --i-understand-this-modifies-networking
      Explicit consent. Without this flag the script exits before any
      state-changing operation.

Optional:
  --config-file PATH          Single .conf instead of a directory (implies
                              --skip-switch-test unless overridden carefully)
  --first-profile NAME        Managed profile name for first activation
  --second-profile NAME       Managed profile name for switch test
  --output-dir PATH           Absolute artifact directory outside the repo
  --skip-check-mode           Skip ansible-playbook --check --diff
  --skip-switch-test          Skip server-switch leak probes
  --skip-forced-disconnect    Skip forced disconnect phase
  --skip-suspend              Default; suspend/resume is off unless enabled
  --enable-suspend            Interactive suspend/resume checkpoint
  --skip-uninstall            Leave the installation in place after tests
  --snapshot-confirmed        Non-interactive confirmation that a VM snapshot
                              exists (script cannot verify Boxes snapshots)
  --allow-non-vm              Dangerous override when not virtualized
  --allow-non-vm-confirmed    Required with --allow-non-vm in --non-interactive
  --keep-artifacts            Keep artifact directory (default)
  --non-interactive           No prompts; requires --snapshot-confirmed
  --allow-dirty-tree          Allow uncommitted changes (development only)
  -h, --help                  Show this help

Safety:
  - Refuses root execution
  - Refuses bare-metal / non-VM by default
  - Refuses ordinary containers
  - Does not flush firewalls or disable the kill switch on failure
  - Never prints PrivateKey material

This entry point must not be invoked by tools/validate-safe, pre-commit,
or GitHub-hosted CI.
EOF
}

log() { printf '[integration-test-vm] %s\n' "$*"; }
die() {
  printf '[integration-test-vm] ERROR: %s\n' "$*" >&2
  exit 2
}

write_artifact() {
  local name="$1"
  local content="$2"
  local path="${ARTIFACT_DIR}/${name}"
  it_redact_text "${content}" >"${path}"
}

append_artifact() {
  local name="$1"
  local content="$2"
  local path="${ARTIFACT_DIR}/${name}"
  # Command substitution strips trailing newlines; keep artifact records separated.
  if [[ -n "${content}" && "${content}" != *$'\n' ]]; then
    content="${content}"$'\n'
  fi
  it_redact_text "${content}" >>"${path}"
}

run_capture() {
  # run_capture logfile command...
  local logfile="$1"
  shift
  local out rc=0
  set +e
  out="$("$@" 2>&1)"
  rc=$?
  set -e
  write_artifact "${logfile}" "${out}"$'\n'"[exit=${rc}]"$'\n'
  return "${rc}"
}

sudo_capture() {
  local logfile="$1"
  shift
  if sudo -n true >/dev/null 2>&1; then
    run_capture "${logfile}" sudo -n "$@"
  else
    run_capture "${logfile}" sudo "$@"
  fi
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config-source)
        CONFIG_SOURCE="${2:-}"
        [[ -n "${CONFIG_SOURCE}" ]] || die "--config-source requires a path"
        shift 2
        ;;
      --config-file)
        CONFIG_FILE="${2:-}"
        [[ -n "${CONFIG_FILE}" ]] || die "--config-file requires a path"
        shift 2
        ;;
      --first-profile)
        FIRST_PROFILE="${2:-}"
        shift 2
        ;;
      --second-profile)
        SECOND_PROFILE="${2:-}"
        shift 2
        ;;
      --output-dir)
        OUTPUT_DIR="${2:-}"
        shift 2
        ;;
      --skip-check-mode) SKIP_CHECK_MODE=1; shift ;;
      --skip-switch-test) SKIP_SWITCH=1; shift ;;
      --skip-forced-disconnect) SKIP_FORCED_DISCONNECT=1; shift ;;
      --skip-suspend) SKIP_SUSPEND=1; RUN_SUSPEND=0; shift ;;
      --enable-suspend) RUN_SUSPEND=1; SKIP_SUSPEND=0; shift ;;
      --skip-uninstall) SKIP_UNINSTALL=1; shift ;;
      --snapshot-confirmed) SNAPSHOT_CONFIRMED=1; shift ;;
      --allow-non-vm) ALLOW_NON_VM=1; shift ;;
      --allow-non-vm-confirmed) ALLOW_NON_VM_CONFIRMED=1; shift ;;
      --keep-artifacts) KEEP_ARTIFACTS=1; shift ;;
      --non-interactive) NON_INTERACTIVE=1; shift ;;
      --allow-dirty-tree) ALLOW_DIRTY_TREE=1; shift ;;
      --i-understand-this-modifies-networking) CONSENT=1; shift ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1"
        ;;
    esac
  done
}

require_cmd() {
  local c="$1"
  command -v "${c}" >/dev/null 2>&1 || die "Required command not found: ${c}. Install it manually; this wrapper does not auto-install packages."
}

detect_container_like() {
  if [[ -f /.dockerenv ]] || [[ -f /run/.containerenv ]]; then
    return 0
  fi
  if [[ -r /proc/1/environ ]] && tr '\0' '\n' </proc/1/environ 2>/dev/null | grep -q '^container='; then
    return 0
  fi
  return 1
}

confirm_snapshot() {
  if ((SNAPSHOT_CONFIRMED)); then
    return 0
  fi
  if ((NON_INTERACTIVE)); then
    die "--non-interactive requires --snapshot-confirmed (this script cannot verify GNOME Boxes snapshots)"
  fi
  cat <<'EOF'
========================================================================
SNAPSHOT REQUIRED
Create a VM snapshot now (for example in GNOME Boxes) before continuing.
This script cannot verify Boxes snapshots reliably.
If anything goes wrong, restore the snapshot rather than flushing firewalls.
========================================================================
EOF
  local ans
  read -r -p "Type SNAPSHOT_CREATED to continue: " ans
  [[ "${ans}" == "SNAPSHOT_CREATED" ]] || die "Snapshot confirmation aborted"
}

confirm_allow_non_vm() {
  if ((ALLOW_NON_VM == 0)); then
    return 0
  fi
  log "WARNING: --allow-non-vm is strongly discouraged. Prefer a disposable Fedora VM."
  if ((NON_INTERACTIVE)); then
    ((ALLOW_NON_VM_CONFIRMED)) || die "--allow-non-vm in --non-interactive mode also requires --allow-non-vm-confirmed"
    return 0
  fi
  local ans
  read -r -p "Type I_ACCEPT_HOST_NETWORK_RISK to continue on a non-VM host: " ans
  [[ "${ans}" == "I_ACCEPT_HOST_NETWORK_RISK" ]] || die "Non-VM override aborted"
}

lookup_public_ip() {
  local family="$1"
  if [[ "${family}" == "4" ]]; then
    it_lookup_public_ipv4
    return $?
  fi

  # IPv6: bounded single-pass providers with exact validation (no || true status wipe).
  local -a urls=("${IT_DEFAULT_IPV6_URLS[@]}")
  local url body_file body curl_rc restore_errexit=0
  body_file="$(mktemp)"
  [[ $- == *e* ]] && restore_errexit=1
  for url in "${urls[@]}"; do
    : >"${body_file}"
    set +e
    curl -6 -fsS \
      --connect-timeout "${IT_PUBLIC_IP_CONNECT_TIMEOUT}" \
      --max-time "${IT_PUBLIC_IP_MAX_TIME}" \
      -o "${body_file}" \
      "${url}"
    curl_rc=$?
    ((restore_errexit)) && set -e
    body="$(it_trim "$(cat "${body_file}" 2>/dev/null || true)")"
    if [[ "${curl_rc}" -eq 0 && -n "${body}" && "${body}" != *[[:space:]]* ]] &&
      airvpn_valid_ipv6 "${body}"; then
      rm -f -- "${body_file}"
      printf '%s\n' "${body}"
      return 0
    fi
  done
  rm -f -- "${body_file}"
  return 1
}

probe_public_http() {
  # Returns 0 on success (connectivity), 1 on failure/timeout — fail-closed PASS when offline.
  local family="$1"
  curl -"${family}" -fsS --max-time 5 -o /dev/null "https://example.com" 2>/dev/null
}

probe_dns() {
  local name="${1:-example.com}"
  getent hosts "${name}" >/dev/null 2>&1
}

list_config_files() {
  local dir="$1"
  find "${dir}" -maxdepth 1 -type f -name '*.conf' | sort
}

validate_config_endpoints() {
  local dir="$1"
  local f endpoint rc
  local count=0
  while IFS= read -r f; do
    [[ -n "${f}" ]] || continue
    endpoint="$(airvpn_wg_field "${f}" "Endpoint" || true)"
    [[ -n "${endpoint}" ]] || die "Missing Endpoint in $(basename "${f}")"
    rc=0
    airvpn_parse_endpoint "${endpoint}" || rc=$?
    if ((rc == 2)); then
      die "Hostname Endpoint not supported in $(basename "${f}"); export numeric IP configs from AirVPN"
    fi
    ((rc == 0)) || die "Malformed Endpoint in $(basename "${f}")"
    count=$((count + 1))
  done < <(list_config_files "${dir}")
  printf '%s\n' "${count}"
}

resolve_ansible() {
  if [[ -x "${ROOT}/.venv/bin/ansible-playbook" ]]; then
    ANSIBLE_BIN="${ROOT}/.venv/bin/ansible-playbook"
  elif command -v ansible-playbook >/dev/null 2>&1; then
    ANSIBLE_BIN="$(command -v ansible-playbook)"
  else
    die "ansible-playbook not found. Prepare the controller with: ./bootstrap.sh --config-source ${CONFIG_SOURCE:-/path} --skip-playbook"
  fi
}

# Match bootstrap.sh: force system Python so firewalld bindings resolve on the host.
ansible_common_args() {
  it_ansible_common_args "${ROOT}/inventory/localhost.yml" "${ANSIBLE_PYTHON_INTERPRETER}"
}

# Lifecycle playbooks use become=sudo. Ansible must prompt on the TTY; this runner
# never reads, stores, logs, or exports the become password.
require_ansible_become_tty() {
  if ((NON_INTERACTIVE)); then
    die "Ansible lifecycle phases require interactive become prompting. Omit --non-interactive and run from a terminal."
  fi
  if [[ ! -r /dev/tty || ! -w /dev/tty ]]; then
    die "Ansible become password prompting requires a usable /dev/tty. Run from an interactive terminal without redirecting away the TTY."
  fi
}

# Build argv for privilege-requiring lifecycle playbooks (null-delimited on stdout).
ansible_lifecycle_args() {
  # ansible_lifecycle_args playbook.yml [extra ansible args...]
  local playbook="$1"
  shift
  it_ansible_lifecycle_args \
    "${ROOT}/inventory/localhost.yml" \
    "${ANSIBLE_PYTHON_INTERPRETER}" \
    "${playbook}" \
    "$@"
}

run_ansible_capture() {
  # run_ansible_capture logfile playbook.yml [extra ansible args...]
  # For become-requiring lifecycle runs only (install/check/idempotency/uninstall).
  # Syntax-check must keep using run_capture without --ask-become-pass.
  local logfile="$1"
  local playbook="$2"
  shift 2
  local -a args=()
  local arg raw rc=0

  require_ansible_become_tty

  while IFS= read -r -d '' arg; do
    args+=("${arg}")
  done < <(ansible_lifecycle_args "${playbook}" "$@")

  raw="${ARTIFACT_DIR}/${logfile}.raw"
  : >"${raw}"
  log "Ansible may prompt for the BECOME (sudo) password. The password is handled by Ansible only; this runner does not read, store, or write it to artifacts."
  set +e
  # Keep stdin on the TTY; tee mirrors non-secret Ansible output to the terminal and a raw log.
  # Do not use command substitution here: it hides prompts and can detach interactive become UX.
  set -o pipefail
  "${ANSIBLE_BIN}" "${args[@]}" </dev/tty 2>&1 | tee -a "${raw}"
  rc=${PIPESTATUS[0]}
  set +o pipefail
  set -e
  write_artifact "${logfile}" "$(cat "${raw}")"$'\n'"[exit=${rc}]"$'\n'
  rm -f "${raw}"
  return "${rc}"
}

reload_runtime_config() {
  # Prefer installed runtime conf after install; falls back to sourced defaults.
  if [[ -r "${AIRVPN_CONFIG_DIR}/airvpn-client.conf" ]]; then
    airvpn_load_config
  fi
}

nmcli_connection_terse() {
  sudo nmcli -t -f UUID,NAME,TYPE,DEVICE,STATE connection show 2>/dev/null || true
}

count_active_managed() {
  reload_runtime_config
  it_count_active_managed_from_terse "${AIRVPN_CONNECTION_PREFIX}" "$(nmcli_connection_terse)"
}

managed_profile_names() {
  reload_runtime_config
  it_managed_names_from_terse "${AIRVPN_CONNECTION_PREFIX}" "$(nmcli_connection_terse)"
}

sudo_firewall_cmd() {
  if sudo -n true >/dev/null 2>&1; then
    sudo -n firewall-cmd "$@"
  else
    sudo firewall-cmd "$@"
  fi
}

phase_mark() {
  local status="$1"
  local name="$2"
  local detail="${3:-}"
  it_phase_record "${status}" "${name}" "${detail}"
  log "${status}: ${name}${detail:+ — ${detail}}"
}

on_failure_guidance() {
  STATE_UNCERTAIN=1
  KILL_SWITCH_MAY_BE_ACTIVE=1
  cat <<'EOF' >&2
------------------------------------------------------------------------
A required phase failed. The kill switch may still be ACTIVE.
This runner will NOT disable firewalld, flush nftables/iptables, or run
firewall-cmd --panic-off / --complete-reload as recovery.
Prefer restoring your VM snapshot.
If uninstall was not completed, run it manually only when you understand
that uninstall can restore direct Internet access.
------------------------------------------------------------------------
EOF
}

# Read-only policy-routing diagnostics after VPN activation (no secrets).
capture_vpn_routing_diagnostics() {
  local prefix="${1:-vpn}"
  local probe4="${AIRVPN_ROUTE_PROBE_V4:-192.0.2.1}"
  local probe6="${AIRVPN_ROUTE_PROBE_V6:-2001:db8::1}"
  local uuid=""
  local active_line=""
  reload_runtime_config
  active_line="$(nmcli -t -f UUID,NAME,TYPE,DEVICE,STATE connection show --active 2>/dev/null | grep -F "${AIRVPN_CONNECTION_PREFIX}" | head -n1 || true)"
  if [[ -n "${active_line}" ]]; then
    uuid="${active_line%%:*}"
  fi
  {
    echo "=== ip -4 rule show ==="
    ip -4 rule show 2>&1 || true
    echo "=== ip -6 rule show ==="
    ip -6 rule show 2>&1 || true
    echo "=== ip -4 route show table main ==="
    ip -4 route show table main 2>&1 || true
    echo "=== ip -6 route show table main ==="
    ip -6 route show table main 2>&1 || true
    echo "=== ip -4 route show table all ==="
    ip -4 route show table all 2>&1 || true
    echo "=== ip -6 route show table all ==="
    ip -6 route show table all 2>&1 || true
    echo "=== ip -4 route get ${probe4} ==="
    ip -4 route get "${probe4}" 2>&1 || true
    echo "=== ip -6 route get ${probe6} ==="
    ip -6 route get "${probe6}" 2>&1 || true
    if [[ -n "${uuid}" ]]; then
      echo "=== nmcli non-secret route fields uuid=${uuid} ==="
      # Explicit allowlist — never request private-key fields.
      nmcli -g connection.id,connection.uuid,connection.interface-name,connection.zone,connection.autoconnect,ipv4.method,ipv4.never-default,ipv4.route-table,ipv4.routing-rules,ipv4.dns-priority,ipv4.dns-search,ipv6.method,ipv6.never-default,ipv6.route-table,ipv6.routing-rules,ipv6.dns-priority,ipv6.dns-search,wireguard.peer-routes,wireguard.fwmark,wireguard.ip4-auto-default-route,wireguard.ip6-auto-default-route \
        connection show "${uuid}" 2>&1 || true
    else
      echo "=== nmcli route fields skipped (no active managed UUID detected) ==="
    fi
  } >"${ARTIFACT_DIR}/${prefix}-routing.raw" 2>&1 || true
  it_redact_text "$(cat "${ARTIFACT_DIR}/${prefix}-routing.raw")" >"${ARTIFACT_DIR}/${prefix}-routing.txt"
  rm -f "${ARTIFACT_DIR}/${prefix}-routing.raw"
}

preflight() {
  local phase="preflight"
  if [[ "${EUID}" -eq 0 ]]; then
    die "Refusing to run as root. Run as a normal user; sudo is used only for privileged steps."
  fi

  local msg
  msg="$(it_validate_option_combo "${CONSENT}" "${CONFIG_SOURCE}" "${CONFIG_FILE}" \
    "${SKIP_SWITCH}" "${FIRST_PROFILE}" "${SECOND_PROFILE}")" || die "${msg}"

  [[ -d "${ROOT}/.git" && -f "${ROOT}/README.md" ]] || die "Not inside the expected Git repository"
  cd "${ROOT}"

  if [[ ! -f /etc/os-release ]]; then
    die "Cannot detect OS"
  fi
  # shellcheck disable=SC1091
  source /etc/os-release
  [[ "${ID:-}" == "fedora" ]] || die "Unsupported OS '${ID:-unknown}' (Fedora required)"

  local virt="none"
  if command -v systemd-detect-virt >/dev/null 2>&1; then
    virt="$(systemd-detect-virt 2>/dev/null || echo none)"
  fi
  local container_like=0
  if detect_container_like; then
    container_like=1
  fi
  # systemd-detect-virt may report container types; treat them as containers.
  case "${virt}" in
    docker | podman | lxc | lxc-libvirt | systemd-nspawn | container-other | wsl)
      container_like=1
      ;;
  esac
  local decision
  decision="$(it_virt_decision "${virt}" "${ALLOW_NON_VM}" "${container_like}")"
  case "${decision}" in
    refuse_container)
      die "Ordinary container environments are not supported for firewall integration testing (detected virt=${virt})"
      ;;
    refuse_non_vm)
      die "No supported virtualized environment detected (virt=${virt}). Use a disposable Fedora VM, or pass --allow-non-vm (strongly discouraged)."
      ;;
  esac
  confirm_allow_non_vm

  require_cmd curl
  require_cmd nmcli
  require_cmd firewall-cmd
  require_cmd wg
  require_cmd flock
  require_cmd getent
  require_cmd sudo
  require_cmd git
  resolve_ansible

  for f in \
    playbooks/install.yml \
    playbooks/uninstall.yml \
    playbooks/verify.yml \
    tools/validate-safe \
    roles/airvpn_client/files/airvpn-switch \
    roles/airvpn_client/files/airvpn-check; do
    [[ -e "${ROOT}/${f}" ]] || die "Missing required repository file: ${f}"
  done

  if [[ -n "${CONFIG_FILE}" ]]; then
    [[ "${CONFIG_FILE}" == /* ]] || die "--config-file must be absolute"
    it_path_outside_repo "${CONFIG_FILE}" "${ROOT}" || die "Config file must be outside the Git repository"
    [[ -f "${CONFIG_FILE}" ]] || die "Config file not found: ${CONFIG_FILE}"
    local tmpdir
    tmpdir="$(mktemp -d /tmp/airvpn-it-cfg-XXXXXX)"
    install -m 0600 "${CONFIG_FILE}" "${tmpdir}/$(basename "${CONFIG_FILE}")"
    CONFIG_SOURCE="${tmpdir}"
    SKIP_SWITCH=1
    log "Using single --config-file; switch test disabled"
  fi

  [[ -n "${CONFIG_SOURCE}" ]] || die "--config-source is required"
  [[ "${CONFIG_SOURCE}" == /* ]] || die "--config-source must be absolute"
  it_path_outside_repo "${CONFIG_SOURCE}" "${ROOT}" || die "Config source must be outside the Git repository"
  [[ -d "${CONFIG_SOURCE}" ]] || die "Config source directory not found: ${CONFIG_SOURCE}"

  local mode
  mode="$(stat -c '%a' "${CONFIG_SOURCE}" 2>/dev/null || true)"
  if [[ -n "${mode}" && "${mode}" != "700" && "${mode}" != "750" && "${mode}" != "755" && "${mode}" != "711" ]]; then
    log "WARN: config source mode is ${mode}; prefer 700"
  fi

  local conf_count
  conf_count="$(validate_config_endpoints "${CONFIG_SOURCE}")"
  ((conf_count >= 1)) || die "Need at least one AirVPN .conf in ${CONFIG_SOURCE}"
  if ((SKIP_SWITCH == 0 && conf_count < 2)); then
    die "Switch test requires at least two configs (found ${conf_count}). Add configs or pass --skip-switch-test."
  fi

  local tracked_bad=0
  while IFS= read -r path; do
    [[ -z "${path}" ]] && continue
    case "${path}" in
      tests/fixtures/*.conf) ;;
      *)
        log "Tracked .conf outside fixtures: ${path}"
        tracked_bad=1
        ;;
    esac
  done < <(git ls-files '*.conf')
  ((tracked_bad == 0)) || die "Refusing to run while real/tracked AirVPN confs exist outside tests/fixtures"

  if ((ALLOW_DIRTY_TREE == 0)); then
    if [[ -n "$(git status --porcelain)" ]]; then
      die "Unexpected uncommitted changes. Commit/stash them or pass --allow-dirty-tree."
    fi
  fi

  local rev
  rev="$(git rev-parse --short HEAD)"
  log "Git revision: ${rev} (branch $(git rev-parse --abbrev-ref HEAD))"

  if [[ -n "${OUTPUT_DIR}" ]]; then
    it_artifact_path_is_safe "${OUTPUT_DIR}" "${ROOT}" || die "Unsafe --output-dir (must be absolute and outside the repository)"
    ARTIFACT_DIR="${OUTPUT_DIR}"
  else
    ARTIFACT_DIR="/tmp/fedora-airvpn-live-test-$(date +%Y%m%d-%H%M%S)"
  fi
  mkdir -p "${ARTIFACT_DIR}"
  chmod 700 "${ARTIFACT_DIR}" || true
  log "Artifacts: ${ARTIFACT_DIR}"

  write_artifact "metadata.txt" "$(
    cat <<EOF
date=$(date -Is)
hostname=$(hostname 2>/dev/null || true)
user=$(id -un)
uid=$(id -u)
fedora_version=${VERSION_ID:-unknown}
virt=${virt}
git_rev=$(git rev-parse HEAD)
git_branch=$(git rev-parse --abbrev-ref HEAD)
config_source=${CONFIG_SOURCE}
conf_count=${conf_count}
skip_switch=${SKIP_SWITCH}
skip_uninstall=${SKIP_UNINSTALL}
run_suspend=${RUN_SUSPEND}
ansible=${ANSIBLE_BIN}
note=Reports may contain network metadata (endpoint/public IPs). Private keys are redacted.
EOF
  )"

  confirm_snapshot
  phase_mark PASS "${phase}" "virt=${virt} configs=${conf_count}"
}

phase_static() {
  local phase="static-validation"
  if run_capture "static-validation.log" "${ROOT}/tools/validate-safe"; then
    phase_mark PASS "${phase}"
  else
    phase_mark FAIL "${phase}" "tools/validate-safe failed"
    on_failure_guidance
    return 1
  fi
}

phase_ansible_syntax() {
  local phase="ansible-syntax"
  local ok=1
  local pb
  local -a common=()
  local arg
  while IFS= read -r -d '' arg; do
    common+=("${arg}")
  done < <(ansible_common_args)
  for pb in install.yml verify.yml uninstall.yml; do
    if ! run_capture "ansible-syntax-${pb}.log" "${ANSIBLE_BIN}" --syntax-check \
      "${common[@]}" "${ROOT}/playbooks/${pb}" \
      -e "airvpn_config_source=${CONFIG_SOURCE}" \
      -e "airvpn_uninstall_confirmed=true"; then
      ok=0
    fi
  done
  if ((ok)); then
    phase_mark PASS "${phase}"
  else
    phase_mark FAIL "${phase}"
    return 1
  fi

  if ((SKIP_CHECK_MODE)); then
    phase_mark SKIP "ansible-check-mode" "requested"
    return 0
  fi
  log "Running ansible-playbook --check --diff (advisory; does not prove live correctness)."
  log "Diff output is redacted when written to artifacts; secrets may still exist in memory."
  set +e
  local rc=0
  run_ansible_capture "ansible-check.log" "${ROOT}/playbooks/install.yml" \
    --check --diff \
    -e "airvpn_config_source=${CONFIG_SOURCE}"
  rc=$?
  set -e
  if ((rc == 0)); then
    phase_mark PASS "ansible-check-mode" "advisory"
  else
    phase_mark WARN "ansible-check-mode" "non-zero exit ${rc} (advisory)"
  fi
}

phase_baseline() {
  local phase="baseline"
  {
    echo "=== nmcli connection show --active ==="
    nmcli -t -f UUID,NAME,TYPE,DEVICE,STATE connection show --active || true
    echo "=== ip -br link ==="
    ip -br link || true
    echo "=== firewall-cmd --get-active-zones ==="
    sudo_firewall_cmd --get-active-zones 2>/dev/null || true
    echo "=== firewall-cmd --get-policies ==="
    sudo_firewall_cmd --get-policies 2>/dev/null || true
    echo "=== ip -4 route ==="
    ip -4 route || true
    echo "=== ip -6 route ==="
    ip -6 route || true
    echo "=== resolvectl status ==="
    resolvectl status 2>/dev/null || true
  } >"${ARTIFACT_DIR}/baseline-network.raw" 2>&1 || true
  it_redact_text "$(cat "${ARTIFACT_DIR}/baseline-network.raw")" >"${ARTIFACT_DIR}/baseline-network.txt"
  rm -f "${ARTIFACT_DIR}/baseline-network.raw"

  BASELINE_IPV4="$(lookup_public_ip 4 || true)"
  BASELINE_IPV6="$(lookup_public_ip 6 || true)"
  write_artifact "baseline-public-ip.txt" "ipv4=${BASELINE_IPV4:-unavailable}"$'\n'"ipv6=${BASELINE_IPV6:-unavailable}"$'\n'
  phase_mark PASS "${phase}" "baseline_ipv4=${BASELINE_IPV4:-none}"
