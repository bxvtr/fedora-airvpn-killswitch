---
extends: default

ignore: |
  .venv/
  .ansible/
  collections/
  .git/

# Keep compatibility with ansible-lint's required yamllint subset:
# https://docs.ansible.com/projects/lint/rules/yaml/
rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  indentation:
    spaces: 2
  document-start:
    present: true
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
